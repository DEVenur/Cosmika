# Example custom commands. Copy to `commands.py` to activate:
#
#     cp custom/commands.py.example custom/commands.py
#
# Files in custom/ are gitignored — your code never shows up in `git status`.
# Drop as many .py files in here as you like; every one is auto-loaded at startup.

from dango.extensions import Ctx, command, command_and_tool


# ── A plain Discord slash command (NOT callable by the agent) ────────────────
# The function returns a string; the framework sends it as the reply.
# Declare `ctx` as the first parameter to learn who/where invoked it.
@command(name="ping", description="Health check")
async def ping(ctx: Ctx) -> str:
    return f"pong 🏓 (called by {ctx.author_name} in #{ctx.channel_name})"


# ── A command that is ALSO an agent tool ─────────────────────────────────────
# Usable as `/echo text:hello` in Discord AND callable by the LLM mid-chat.
# Keep parameters to simple scalars (str / int / bool / float) so both the
# Discord command schema and the agent tool schema can represent them.
@command_and_tool(name="echo", description="Echo a message back")
async def echo(ctx: Ctx, text: str) -> str:
    """Echo the given text back to the user.

    Args:
        text: The text to echo back.
    """
    return text


# ── Parameters with defaults become optional ─────────────────────────────────
@command(name="roll", description="Roll an N-sided die")
async def roll(ctx: Ctx, sides: int = 6) -> str:
    import random

    return f"🎲 {random.randint(1, sides)} (1–{sides})"
