# Example custom agent tools. Copy to `tools.py` to activate:
#
#     cp custom/tools.py.example custom/tools.py
#
# Tools registered with @agent_tool are callable by the LLM during a chat turn,
# but are NOT exposed as Discord slash commands.

from dango.extensions import Ctx, agent_tool


# ── A pure agent tool (no Discord command) ───────────────────────────────────
# The docstring becomes the tool description and documents each argument for
# the model. Write it carefully — the LLM reads it to decide when/how to call.
@agent_tool()
def word_count(text: str) -> str:
    """Count the words and characters in a piece of text.

    Args:
        text: The text to analyze.
    """
    words = len(text.split())
    return f"{words} words, {len(text)} characters"


# ── A tool that uses Ctx to adapt to the caller ──────────────────────────────
# `ctx` is optional; declare it as the first parameter only if you need it.
# For agent calls, ctx.source == "agent" and channel/guild come from the
# current Discord message context.
@agent_tool(name="whoami", description="Report who is talking and where")
def whoami(ctx: Ctx) -> str:
    return (
        f"You are talking to {ctx.author_name} "
        f"in guild '{ctx.guild_name}' channel #{ctx.channel_name}."
    )


